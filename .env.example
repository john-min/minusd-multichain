# Copy to .env locally. Placeholders only — never commit real keys or RPC tokens.

# Hex private key for Foundry scripts. Use a dedicated testnet wallet.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Optional. Defaults to the address derived from PRIVATE_KEY.
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS

# Public Base Sepolia RPC is fine. Do not commit authenticated RPC URLs with keys.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional contract verification
ETHERSCAN_API_KEY=
